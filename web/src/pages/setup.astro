---
// Installation du portail (auto-hebergement). Affichee tant que l'instance n'est pas configuree ; la garde
// (middleware) y renvoie toute page. L'ecran est le composant SetupWizard (Svelte) ; le serveur lui donne
// la fenetre restante, les types de base (DB_KIND) et les libelles des verifications de noms (HOST_CHECK).
import BareLayout from '../layouts/BareLayout.astro';
import SetupWizard from '../components/islands/SetupWizard.svelte';
import { LANG, ROUTES, t } from '../lib/i18n.ts';
import { DB_KIND, isConfigured, setupWindowRemaining, SETUP_WINDOW_S } from '@core/config.js';
import { HOST_CHECK, type HostCheck } from '../server/hosts.ts';
if (isConfigured()) return Astro.redirect('/');
const checkLabels = {
  [HOST_CHECK.appFormat]: 'Portail : format', [HOST_CHECK.appDns]: 'Portail : DNS', [HOST_CHECK.appReach]: 'Portail : joignable',
  [HOST_CHECK.brokerFormat]: 'Broker : format', [HOST_CHECK.brokerCert]: 'Broker : certificat', [HOST_CHECK.brokerDns]: 'Broker : DNS', [HOST_CHECK.brokerPort]: 'Broker : joignable',
} satisfies Record<HostCheck, string>;
const s = t(LANG.fr);
---
<BareLayout title="Configuration" lang={LANG.fr}>
  <SetupWizard client:load remaining={setupWindowRemaining()} windowMin={Math.round(SETUP_WINDOW_S / 60)} kinds={DB_KIND}
    checkLabels={checkLabels} userAdminLabel={s.setupUserAdmin} userAdminHint={s.setupUserAdminHint} loginUrl={`${ROUTES.connexion[LANG.fr]}?local=1`} />
</BareLayout>
