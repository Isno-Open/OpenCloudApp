---
// Onboarding du portail (auto-hebergement). Affiche tant que l'instance n'est pas configuree ; la garde
// (middleware) y renvoie toute page. Ouvert seulement pendant une fenetre apres le demarrage du serveur
// (pas de jeton) : passe ce delai, il faut redemarrer le serveur. Deux etapes : base de donnees, puis
// socle (URLs + admin) ; ecriture de la config et redemarrage. Valeurs de base issues de l'enum DB_KIND.
import BareLayout from '../layouts/BareLayout.astro';
import { LANG } from '../lib/i18n.ts';
import { DB_KIND, isConfigured, setupWindowRemaining, SETUP_WINDOW_S } from '@core/config.js';
if (isConfigured()) return Astro.redirect('/');
const remaining = setupWindowRemaining();
const windowMin = Math.round(SETUP_WINDOW_S / 60);
---
<BareLayout title="Configuration · ISNO Cloud" lang={LANG.fr}>
  <div class="setup">
    <div class="setup-head">
      <span class="eyebrow">// onboarding</span>
      <h1>Configuration du portail</h1>
      <p class="sub">Première installation : deux étapes, puis le portail redémarre configuré.</p>
      {remaining > 0 && (
        <>
          <p class="window" id="windowBar">Installation ouverte encore <b id="countdown">{Math.floor(remaining / 60)}:{String(remaining % 60).padStart(2, '0')}</b>. Par sécurité, elle se ferme {windowMin} minutes après le démarrage du serveur.</p>
          <div class="steps">
            <span class="st active" data-dot="1">1 · Base de données</span>
            <span class="st" data-dot="2">2 · Socle</span>
          </div>
        </>
      )}
    </div>

    <div class="setup-card expired" id="expired" hidden={remaining > 0}>
      <h3>Délai d'installation dépassé</h3>
      <p class="note">Par sécurité, l'installation n'est ouverte que pendant les {windowMin} minutes qui suivent le démarrage du serveur : sinon, n'importe qui trouvant ce portail en ligne pourrait le configurer à votre place.</p>
      <p class="note">Redémarrez le serveur, puis rechargez cette page :</p>
      <pre class="cmd">docker compose restart server</pre>
    </div>

    {remaining > 0 && (
      <form id="setupForm" class="setup-card">
        <!-- Etape 1 : base de donnees -->
        <section class="step" data-step="1">
          <h3>Base de données</h3>
          <label class="opt"><input type="radio" name="kind" value="" data-k="sqlite" checked /><span><b>SQLite</b> (embarqué, recommandé). Rien à installer, un fichier sur le volume. Idéal pour un parc modeste.</span></label>
          <label class="opt"><input type="radio" name="kind" value="" data-k="mongoBundled" /><span><b>MongoDB fourni</b>. Installé automatiquement sur ce serveur (téléchargement de quelques centaines de Mo). Pour grandir.</span></label>
          <label class="opt"><input type="radio" name="kind" value="" data-k="mongoExternal" /><span><b>MongoDB externe</b>. Votre propre serveur Mongo.</span></label>
          <div class="module" id="modulePanel" hidden>
            <p class="note" id="moduleMsg">Vérification…</p>
            <div class="bar" id="moduleBarWrap" hidden><span id="moduleBar"></span></div>
            <button type="button" class="btn primary" id="installBtn" hidden>Installer MongoDB</button>
          </div>
          <div class="field" id="mongoUrlField" hidden><label for="mongoUrl">URL Mongo</label><input id="mongoUrl" name="mongoUrl" type="text" placeholder="mongodb://utilisateur:motdepasse@hote:27017/isno_cloud" spellcheck="false" /></div>
          <div class="testline"><button type="button" class="btn ghost" id="testBtn">Tester la connexion</button><span class="testmsg" id="testMsg"></span></div>
          <div class="row end"><button type="button" class="btn primary" data-next="1">Continuer</button></div>
        </section>

        <!-- Etape 2 : socle -->
        <section class="step" data-step="2" hidden>
          <h3>Socle</h3>
          <div class="field"><label for="appHost">Nom d'hôte du portail</label><input id="appHost" name="appHost" type="text" placeholder="cloud.exemple.fr" spellcheck="false" autocapitalize="none" required /><span class="hint">L'adresse où vous êtes en ce moment.</span></div>
          <div class="field"><label for="brokerHost">Nom d'hôte du broker MQTT</label><input id="brokerHost" name="brokerHost" type="text" placeholder="mqtt.exemple.fr" spellcheck="false" autocapitalize="none" required /><span class="hint" id="brokerHint">Celui inscrit dans le certificat du broker : les boîtiers n'en acceptent pas d'autre.</span></div>
          <div class="testline"><button type="button" class="btn ghost" id="checkBtn">Vérifier les noms d'hôte</button></div>
          <ul class="checks" id="checks" hidden></ul>
          <div class="field"><label for="adminPassword">Mot de passe administrateur</label><input id="adminPassword" name="adminPassword" type="password" autocomplete="new-password" minlength="8" required /><span class="hint">8 caractères minimum. Compte <code>admin</code>, pour la connexion opérateur.</span></div>
          <div class="row"><button type="button" class="btn ghost" data-prev="2">Retour</button><button type="submit" class="btn primary" id="finishBtn">Terminer et démarrer</button></div>
          <p class="formerr" id="formErr" hidden></p>
        </section>

        <!-- Etape 3 : redemarrage -->
        <section class="step done" data-step="3" hidden>
          <h3>Démarrage…</h3>
          <p class="note">Configuration enregistrée. Le portail redémarre avec la base choisie. Cette page s'ouvrira automatiquement sur la connexion opérateur.</p>
          <div class="spinner" aria-hidden="true"></div>
        </section>
      </form>
    )}
  </div>

  <style>
    .setup { max-width: 540px; margin: 0 auto; width: 100%; }
    .setup-head { margin-bottom: 1.1rem; }
    .setup-head .eyebrow { font-family: var(--font-mono); font-size: .78rem; letter-spacing: .12em; text-transform: uppercase; color: var(--accent2); }
    .setup-head h1 { font-family: var(--font-sans); font-weight: 800; font-size: 1.7rem; letter-spacing: -.02em; margin: .3rem 0 .2rem; }
    .setup-head .sub { color: var(--text-muted); font-size: .92rem; }
    .window { font-size: .84rem; color: var(--text-muted); margin: .7rem 0 0; }
    .window b { font-family: var(--font-mono); color: var(--accent); }
    .steps { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .9rem; }
    .steps .st { font-family: var(--font-mono); font-size: .72rem; color: var(--text-faint); border: 1px solid var(--border); border-radius: 999px; padding: .2rem .6rem; }
    .steps .st.active { color: var(--accent); border-color: var(--accent-line); background: var(--accent-weak); }
    .setup-card { background: var(--bg-elev); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.3rem; box-shadow: var(--shadow); }
    .setup-card.expired { border-color: color-mix(in srgb, var(--warn) 45%, var(--border)); }
    .step h3, .expired h3 { font-size: 1.05rem; margin: 0 0 .5rem; }
    .cmd { font-family: var(--font-mono); font-size: .85rem; background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: .6rem .8rem; margin: .4rem 0 0; overflow-x: auto; }
    .field { display: flex; flex-direction: column; gap: .3rem; margin: .7rem 0; }
    .field label { font-size: .82rem; color: var(--text-muted); }
    .field input { font: inherit; font-size: .95rem; padding: .55rem .7rem; border-radius: var(--radius-sm); border: 1px solid var(--border); background: var(--surface-2); color: var(--text); }
    .field input:focus { outline: none; border-color: var(--accent); }
    .field .hint { font-size: .76rem; color: var(--text-faint); }
    .opt { display: flex; gap: .6rem; align-items: start; padding: .6rem .7rem; border: 1px solid var(--border); border-radius: var(--radius-sm); margin: .5rem 0; cursor: pointer; font-size: .88rem; color: var(--text-muted); }
    .opt input { margin-top: .2rem; accent-color: var(--accent); }
    .opt b { color: var(--text); font-weight: 650; }
    .module { margin: .6rem 0; padding: .7rem .8rem; border: 1px dashed var(--accent-line); border-radius: var(--radius-sm); background: var(--accent-weak); display: flex; flex-direction: column; gap: .5rem; }
    .module .note { margin: 0; }
    .bar { height: 8px; border-radius: 999px; background: var(--surface-2); border: 1px solid var(--border); overflow: hidden; }
    .bar span { display: block; height: 100%; width: 0; background: var(--accent); transition: width .4s ease; }
    .testline { display: flex; align-items: center; gap: .7rem; margin: .4rem 0 .2rem; flex-wrap: wrap; }
    .testmsg { font-size: .82rem; }
    .testmsg.ok { color: var(--ok); } .testmsg.err { color: var(--danger); }
    code { font-family: var(--font-mono); font-size: .85em; color: var(--accent2); }
    .checks { list-style: none; margin: .3rem 0 .4rem; padding: 0; display: flex; flex-direction: column; gap: .25rem; font-size: .82rem; }
    .checks li.ok { color: var(--ok); } .checks li.ko { color: var(--danger); }
    .spinner { width: 26px; height: 26px; border: 3px solid var(--border); border-top-color: var(--accent); border-radius: 50%; margin: 1rem auto 0; animation: sp 1s linear infinite; }
    @keyframes sp { to { transform: rotate(360deg); } }
  </style>

  <script is:inline define:vars={{ KIND: DB_KIND, remaining }}>
    (function () {
      var form = document.getElementById('setupForm');
      if (!form) return;
      var expired = document.getElementById('expired');
      var done = false;
      // Compte a rebours de la fenetre : a zero, on bascule sur l'ecran « delai depasse ».
      var deadline = Date.now() + remaining * 1000;
      var cd = document.getElementById('countdown');
      var tick = setInterval(function () {
        var left = Math.max(0, Math.round((deadline - Date.now()) / 1000));
        cd.textContent = Math.floor(left / 60) + ':' + String(left % 60).padStart(2, '0');
        if (left === 0 && !done) {
          clearInterval(tick);
          form.hidden = true; document.getElementById('windowBar').hidden = true;
          document.querySelector('.steps').hidden = true; expired.hidden = false;
        }
      }, 1000);
      function show(n) {
        form.querySelectorAll('.step').forEach(function (s) { s.hidden = s.getAttribute('data-step') !== String(n); });
        document.querySelectorAll('.steps .st').forEach(function (d) { d.classList.toggle('active', d.getAttribute('data-dot') === String(Math.min(n, 2))); });
      }
      function kind() { var r = form.querySelector('input[name=kind]:checked'); return r ? r.getAttribute('data-k') : 'sqlite'; }
      function dbPayload() { return { kind: KIND[kind()], mongoUrl: (document.getElementById('mongoUrl') || {}).value || '' }; }
      // Module requis par le choix (Mongo fourni) : etat, installation par le superviseur, progression.
      var moduleReady = true, poll = null;
      var mp = document.getElementById('modulePanel'), mm = document.getElementById('moduleMsg');
      var mbw = document.getElementById('moduleBarWrap'), mb = document.getElementById('moduleBar'), ib = document.getElementById('installBtn');
      var next1 = form.querySelector('[data-next="1"]');
      function renderModule(m) {
        moduleReady = !!m.ready; next1.disabled = !moduleReady;
        if (m.ready) { mm.textContent = '✓ ' + m.title + ' est installé et démarré.'; mbw.hidden = true; ib.hidden = true; return true; }
        if (m.busy) { mm.textContent = 'Installation de ' + m.title + '… ' + m.progress + ' %'; mbw.hidden = false; mb.style.width = m.progress + '%'; ib.hidden = true; return false; }
        mbw.hidden = true; ib.hidden = false; ib.disabled = false;
        mm.textContent = m.error ? '✗ ' + m.error : m.title + " n'est pas encore installé sur ce serveur.";
        return true;
      }
      function moduleError(e) { mm.textContent = '✗ ' + e; ib.hidden = true; moduleReady = false; next1.disabled = true; }
      function checkModule() {
        fetch('/api/setup/module?kind=' + encodeURIComponent(KIND[kind()]))
          .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
          .then(function (res) {
            if (!res.ok) { clearInterval(poll); poll = null; moduleError(res.d.error || 'superviseur indisponible'); return; }
            if (renderModule(res.d) && poll) { clearInterval(poll); poll = null; }
          })
          .catch(function () { moduleError('erreur réseau'); });
      }
      ib.addEventListener('click', function () {
        ib.disabled = true; mm.textContent = 'Démarrage de l\'installation…';
        fetch('/api/setup/module', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ kind: KIND[kind()] }) })
          .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
          .then(function (res) {
            if (!res.ok) { moduleError(res.d.error || 'échec'); return; }
            renderModule(res.d); if (!poll) poll = setInterval(checkModule, 1000);
          })
          .catch(function () { moduleError('erreur réseau'); });
      });
      function onKind() {
        var k = kind();
        document.getElementById('mongoUrlField').hidden = (k !== 'mongoExternal');
        document.getElementById('testMsg').textContent = '';
        if (poll) { clearInterval(poll); poll = null; }
        if (k === 'mongoBundled') { mp.hidden = false; moduleReady = false; next1.disabled = true; mm.textContent = 'Vérification…'; checkModule(); }
        else { mp.hidden = true; moduleReady = true; next1.disabled = false; }
      }
      form.querySelectorAll('input[name=kind]').forEach(function (r) { r.addEventListener('change', onKind); });
      next1.addEventListener('click', function () { if (moduleReady) show(2); });
      form.querySelector('[data-prev="2"]').addEventListener('click', function () { show(1); });

      document.getElementById('testBtn').addEventListener('click', function () {
        var msg = document.getElementById('testMsg'); msg.className = 'testmsg'; msg.textContent = 'Test…';
        fetch('/api/setup/test-db', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(dbPayload()) })
          .then(function (r) { return r.json(); })
          .then(function (d) { msg.className = 'testmsg ' + (d.ok ? 'ok' : 'err'); msg.textContent = d.ok ? '✓ connexion OK' : ('✗ ' + (d.error || 'échec')); })
          .catch(function () { msg.className = 'testmsg err'; msg.textContent = '✗ erreur réseau'; });
      });

      // Noms d'hote : pre-remplis (portail = ou l'on est ; broker = son certificat), puis verifies.
      var LABEL = { appFormat: 'Portail : format', appDns: 'Portail : DNS', appReach: 'Portail : joignable', brokerFormat: 'Broker : format', brokerCert: 'Broker : certificat', brokerDns: 'Broker : DNS', brokerPort: 'Broker : joignable' };
      var checksEl = document.getElementById('checks');
      function renderChecks(list) {
        checksEl.hidden = false; checksEl.textContent = '';
        list.forEach(function (c) { var li = document.createElement('li'); li.className = c.ok ? 'ok' : 'ko'; li.textContent = (c.ok ? '✓ ' : '✗ ') + (LABEL[c.check] || c.check) + ' : ' + c.detail; checksEl.appendChild(li); });
      }
      fetch('/api/setup/defaults').then(function (r) { return r.json(); }).then(function (d) {
        if (d.appHost && !document.getElementById('appHost').value) document.getElementById('appHost').value = d.appHost;
        if (d.brokerHost && !document.getElementById('brokerHost').value) document.getElementById('brokerHost').value = d.brokerHost;
        if (d.brokerCertNames && d.brokerCertNames.length) document.getElementById('brokerHint').textContent = 'Détecté dans le certificat du broker (port ' + d.brokerPort + ') : les boîtiers n\'acceptent pas d\'autre nom.';
      }).catch(function () {});
      document.getElementById('checkBtn').addEventListener('click', function () {
        var b = this; b.disabled = true; checksEl.hidden = false; checksEl.textContent = 'Vérification…';
        fetch('/api/setup/check-hosts', { method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ appHost: document.getElementById('appHost').value, brokerHost: document.getElementById('brokerHost').value }) })
          .then(function (r) { return r.json(); })
          .then(function (d) { if (d.checks) renderChecks(d.checks); else checksEl.textContent = '✗ ' + (d.error || 'échec'); })
          .catch(function () { checksEl.textContent = '✗ erreur réseau'; })
          .finally(function () { b.disabled = false; });
      });

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var err = document.getElementById('formErr'); err.hidden = true;
        var db = dbPayload();
        var payload = {
          kind: db.kind, mongoUrl: db.mongoUrl,
          appHost: document.getElementById('appHost').value.trim(),
          brokerHost: document.getElementById('brokerHost').value.trim(),
          adminPassword: document.getElementById('adminPassword').value,
        };
        document.getElementById('finishBtn').disabled = true;
        fetch('/api/setup/save', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload) })
          .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
          .then(function (res) {
            if (!res.ok) { if (res.d.checks) renderChecks(res.d.checks); err.hidden = false; err.textContent = res.d.error || 'Échec'; document.getElementById('finishBtn').disabled = false; return; }
            done = true; clearInterval(tick); document.getElementById('windowBar').hidden = true;
            show(3);
            var tries = 0;
            var iv = setInterval(function () {
              tries++;
              fetch('/api/setup/status').then(function (r) { return r.json(); }).then(function (d) {
                if (d.configured) { clearInterval(iv); location.href = '/connexion?local=1'; }
              }).catch(function () {});
              if (tries > 40) { clearInterval(iv); location.href = '/connexion?local=1'; }
            }, 1500);
          })
          .catch(function () { err.hidden = false; err.textContent = 'Erreur réseau'; document.getElementById('finishBtn').disabled = false; });
      });

      show(1);
    })();
  </script>
</BareLayout>
