---
// Onboarding du portail (auto-hebergement). Affiche tant que l'instance n'est pas configuree ; la garde
// (middleware) y renvoie toute page. Ouvert seulement pendant une fenetre apres le demarrage du serveur
// (pas de jeton) : passe ce delai, il faut redemarrer le serveur. Deux etapes : base de donnees, puis
// socle (URLs + admin) ; ecriture de la config et redemarrage. Valeurs de base issues de l'enum DB_KIND.
import BareLayout from '../layouts/BareLayout.astro';
import { LANG } from '../lib/i18n.ts';
import { DB_KIND, isConfigured, setupWindowRemaining, SETUP_WINDOW_S } from '@core/config.js';
if (isConfigured()) return Astro.redirect('/');
const remaining = setupWindowRemaining();
const windowMin = Math.round(SETUP_WINDOW_S / 60);
---
<BareLayout title="Configuration · ISNO Cloud" lang={LANG.fr}>
  <div class="setup">
    <div class="setup-head">
      <span class="eyebrow">// onboarding</span>
      <h1>Configuration du portail</h1>
      <p class="sub">Première installation : deux étapes, puis le portail redémarre configuré.</p>
      {remaining > 0 && (
        <>
          <p class="window" id="windowBar">Installation ouverte encore <b id="countdown">{Math.floor(remaining / 60)}:{String(remaining % 60).padStart(2, '0')}</b>. Par sécurité, elle se ferme {windowMin} minutes après le démarrage du serveur.</p>
          <div class="steps">
            <span class="st active" data-dot="1">1 · Base de données</span>
            <span class="st" data-dot="2">2 · Socle</span>
          </div>
        </>
      )}
    </div>

    <div class="setup-card expired" id="expired" hidden={remaining > 0}>
      <h3>Délai d'installation dépassé</h3>
      <p class="note">Par sécurité, l'installation n'est ouverte que pendant les {windowMin} minutes qui suivent le démarrage du serveur : sinon, n'importe qui trouvant ce portail en ligne pourrait le configurer à votre place.</p>
      <p class="note">Redémarrez le serveur, puis rechargez cette page :</p>
      <pre class="cmd">docker compose restart server</pre>
    </div>

    {remaining > 0 && (
      <form id="setupForm" class="setup-card">
        <!-- Etape 1 : base de donnees -->
        <section class="step" data-step="1">
          <h3>Base de données</h3>
          <label class="opt"><input type="radio" name="kind" value="" data-k="sqlite" checked /><span><b>SQLite</b> (embarqué, recommandé). Rien à installer, un fichier sur le volume. Idéal pour un parc modeste.</span></label>
          <label class="opt"><input type="radio" name="kind" value="" data-k="mongoBundled" /><span><b>MongoDB fourni</b>. Installé automatiquement sur ce serveur (téléchargement de quelques centaines de Mo). Pour grandir.</span></label>
          <label class="opt"><input type="radio" name="kind" value="" data-k="mongoExternal" /><span><b>MongoDB externe</b>. Votre propre serveur Mongo.</span></label>
          <div class="bar" id="moduleBarWrap" hidden><span id="moduleBar"></span></div>
          <div class="field" id="mongoUrlField" hidden><label for="mongoUrl">URL Mongo</label><input id="mongoUrl" name="mongoUrl" type="text" placeholder="mongodb://utilisateur:motdepasse@hote:27017/isno_cloud" spellcheck="false" /></div>
          <div class="testline" id="testLine" hidden><button type="button" class="btn ghost" id="testBtn">Tester la connexion</button><span class="testmsg" id="testMsg"></span></div>
          <div class="row end"><button type="button" class="btn primary" data-next="1">Continuer</button></div>
        </section>

        <!-- Etape 2 : socle -->
        <section class="step" data-step="2" hidden>
          <h3>Socle</h3>
          <div class="field"><label for="appHost">Nom d'hôte du portail</label><input id="appHost" name="appHost" type="text" placeholder="cloud.exemple.fr" spellcheck="false" autocapitalize="none" required /><span class="hint">L'adresse où vous êtes en ce moment.</span></div>
          <div class="field"><label for="brokerHost">Nom d'hôte du broker MQTT</label><input id="brokerHost" name="brokerHost" type="text" placeholder="mqtt.exemple.fr" spellcheck="false" autocapitalize="none" required /><span class="hint">Le nom sous lequel les boîtiers joindront le broker : public (Internet) ou réseau local. Son certificat sera créé avec ce nom.</span></div>
          <div class="bar" id="brokerBarWrap" hidden><span id="brokerBar"></span></div>
          <h3 class="sub-h">Opérateur du portail</h3>
          <div class="field"><label for="adminEmail">E-mail</label><input id="adminEmail" name="adminEmail" type="email" autocomplete="email" required /><span class="hint">Votre identifiant de connexion. Vous aurez accès à Paramètres et Utilisateurs.</span></div>
          <div class="field"><label for="adminName">Nom</label><input id="adminName" name="adminName" type="text" autocomplete="name" maxlength="80" required /></div>
          <div class="field"><label for="adminPassword">Mot de passe</label><input id="adminPassword" name="adminPassword" type="password" autocomplete="new-password" minlength="8" required /><span class="hint">8 caractères minimum.</span></div>
          <div class="row"><button type="button" class="btn ghost" data-prev="2">Retour</button><button type="submit" class="btn primary" id="finishBtn">Terminer et démarrer</button></div>
          <p class="formerr" id="formErr" hidden></p>
        </section>

        <!-- Etape 3 : redemarrage -->
        <section class="step done" data-step="3" hidden>
          <h3>Démarrage…</h3>
          <p class="note">Configuration enregistrée. Le portail redémarre avec la base choisie, puis cette page ouvre la connexion : identifiez-vous avec l'e-mail de l'opérateur.</p>
        </section>
        <!-- Journal : chaque operation sur sa ligne, conserve d'une etape a l'autre -->
        <ol class="journal" id="journal" hidden></ol>

      </form>
    )}
  </div>

  <style>
    .setup { max-width: 540px; margin: 0 auto; width: 100%; }
    .setup-head { margin-bottom: 1.1rem; }
    .setup-head .eyebrow { font-family: var(--font-mono); font-size: .78rem; letter-spacing: .12em; text-transform: uppercase; color: var(--accent2); }
    .setup-head h1 { font-family: var(--font-sans); font-weight: 800; font-size: 1.7rem; letter-spacing: -.02em; margin: .3rem 0 .2rem; }
    .setup-head .sub { color: var(--text-muted); font-size: .92rem; }
    .window { font-size: .84rem; color: var(--text-muted); margin: .7rem 0 0; }
    .window b { font-family: var(--font-mono); color: var(--accent); }
    .steps { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .9rem; }
    .steps .st { font-family: var(--font-mono); font-size: .72rem; color: var(--text-faint); border: 1px solid var(--border); border-radius: 999px; padding: .2rem .6rem; }
    .steps .st.active { color: var(--accent); border-color: var(--accent-line); background: var(--accent-weak); }
    .setup-card { background: var(--bg-elev); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.3rem; box-shadow: var(--shadow); }
    .setup-card.expired { border-color: color-mix(in srgb, var(--warn) 45%, var(--border)); }
    .step h3, .expired h3 { font-size: 1.05rem; margin: 0 0 .5rem; }
    .cmd { font-family: var(--font-mono); font-size: .85rem; background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: .6rem .8rem; margin: .4rem 0 0; overflow-x: auto; }
    .field { display: flex; flex-direction: column; gap: .3rem; margin: .7rem 0; }
    .field label { font-size: .82rem; color: var(--text-muted); }
    .field input { font: inherit; font-size: .95rem; padding: .55rem .7rem; border-radius: var(--radius-sm); border: 1px solid var(--border); background: var(--surface-2); color: var(--text); }
    .field input:focus { outline: none; border-color: var(--accent); }
    .field .hint { font-size: .76rem; color: var(--text-faint); }
    .opt { display: flex; gap: .6rem; align-items: start; padding: .6rem .7rem; border: 1px solid var(--border); border-radius: var(--radius-sm); margin: .5rem 0; cursor: pointer; font-size: .88rem; color: var(--text-muted); }
    .opt input { margin-top: .2rem; accent-color: var(--accent); }
    .opt b { color: var(--text); font-weight: 650; }
    .module { margin: .6rem 0; padding: .7rem .8rem; border: 1px dashed var(--accent-line); border-radius: var(--radius-sm); background: var(--accent-weak); display: flex; flex-direction: column; gap: .5rem; }
    .module .note { margin: 0; }
    .bar { height: 8px; border-radius: 999px; background: var(--surface-2); border: 1px solid var(--border); overflow: hidden; }
    .bar span { display: block; height: 100%; width: 0; background: var(--accent); transition: width .4s ease; }
    .testline { display: flex; align-items: center; gap: .7rem; margin: .4rem 0 .2rem; flex-wrap: wrap; }
    .testmsg { font-size: .82rem; }
    .testmsg.ok { color: var(--ok); } .testmsg.err { color: var(--danger); }
    code { font-family: var(--font-mono); font-size: .85em; color: var(--accent2); }
    .journal { list-style: none; margin: 1rem 0 0; padding: .8rem 0 0; border-top: 1px solid var(--border); display: flex; flex-direction: column; gap: .35rem; font-size: .86rem; }
    /* lignes creees en JavaScript : selecteurs globaux, les styles scopes d'Astro ne les atteignent pas */
    .journal :global(li) { display: grid; grid-template-columns: 1.2rem 1fr; column-gap: .4rem; color: var(--text-muted); }
    .journal :global(li .ic) { font-family: var(--font-mono); text-align: center; }
    .journal :global(li.run .ic) { color: var(--accent); animation: blink 1s ease-in-out infinite; }
    .journal :global(li.ok) { color: var(--text); }
    .journal :global(li.ok .ic) { color: var(--ok); }
    .journal :global(li.ko) { color: var(--danger); }
    .journal :global(li .sub) { grid-column: 2; margin-top: .2rem; font-size: .8rem; color: var(--text-faint); display: flex; flex-direction: column; gap: .15rem; }
    .journal :global(li .sub .ko) { color: var(--danger); }
    @keyframes blink { 50% { opacity: .35; } }
    .sub-h { font-size: .95rem; margin: 1.1rem 0 .2rem; padding-top: .8rem; border-top: 1px solid var(--border); }
    .checks { list-style: none; margin: .3rem 0 .4rem; padding: 0; display: flex; flex-direction: column; gap: .25rem; font-size: .82rem; }
    .checks li.ok { color: var(--ok); } .checks li.ko { color: var(--danger); }
    .spinner { width: 26px; height: 26px; border: 3px solid var(--border); border-top-color: var(--accent); border-radius: 50%; margin: 1rem auto 0; animation: sp 1s linear infinite; }
    @keyframes sp { to { transform: rotate(360deg); } }
  </style>

  <script is:inline define:vars={{ KIND: DB_KIND, remaining }}>
    (function () {
      var form = document.getElementById('setupForm');
      if (!form) return;
      var $ = function (id) { return document.getElementById(id); };
      var expired = $('expired'), done = false;
      var post = function (url, body) {
        return fetch(url, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) })
          .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); });
      };
      var getJson = function (url) { return fetch(url).then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); }); };

      // Compte a rebours de la fenetre : a zero, on bascule sur l'ecran « delai depasse ».
      var deadline = Date.now() + remaining * 1000, cd = $('countdown');
      var tick = setInterval(function () {
        var left = Math.max(0, Math.round((deadline - Date.now()) / 1000));
        cd.textContent = Math.floor(left / 60) + ':' + String(left % 60).padStart(2, '0');
        if (left === 0 && !done) {
          clearInterval(tick); form.hidden = true; $('windowBar').hidden = true;
          document.querySelector('.steps').hidden = true; expired.hidden = false;
        }
      }, 1000);

      function show(n) {
        form.querySelectorAll('.step').forEach(function (s) { s.hidden = s.getAttribute('data-step') !== String(n); });
        document.querySelectorAll('.steps .st').forEach(function (d) { d.classList.toggle('active', d.getAttribute('data-dot') === String(Math.min(n, 2))); });
      }
      function kind() { var r = form.querySelector('input[name=kind]:checked'); return r ? r.getAttribute('data-k') : 'sqlite'; }
      function dbPayload() { return { kind: KIND[kind()], mongoUrl: ($('mongoUrl') || {}).value || '' }; }

      // Journal : une ligne par operation (en cours -> ok / echec), jamais effacee.
      var journal = $('journal');
      var ICON = { run: '◌', ok: '✓', ko: '✗' };
      function step(key, text) {
        journal.hidden = false;
        var li = journal.querySelector('[data-k="' + key + '"]');
        if (!li) { li = document.createElement('li'); li.setAttribute('data-k', key); li.innerHTML = '<span class="ic"></span><span class="tx"></span>'; journal.appendChild(li); }
        var api = {
          run: function (t) { li.className = 'run'; li.querySelector('.ic').textContent = ICON.run; li.querySelector('.tx').textContent = t || text; return api; },
          ok: function (t) { li.className = 'ok'; li.querySelector('.ic').textContent = ICON.ok; li.querySelector('.tx').textContent = t || text; return api; },
          ko: function (t) { li.className = 'ko'; li.querySelector('.ic').textContent = ICON.ko; li.querySelector('.tx').textContent = t || text; return api; },
          sub: function (lines) {
            var old = li.querySelector('.sub'); if (old) old.remove();
            var d = document.createElement('span'); d.className = 'sub';
            lines.forEach(function (l) { var e = document.createElement('span'); e.className = l.ok ? '' : 'ko'; e.textContent = (l.ok ? '✓ ' : '✗ ') + l.text; d.appendChild(e); });
            li.appendChild(d); return api;
          },
        };
        return api.run(text);
      }

      // Attend qu'un module soit pret ; la progression s'affiche dans sa ligne du journal.
      function waitModule(statusUrl, line, barWrap, bar, label) {
        return new Promise(function (resolve, reject) {
          var tries = 0;
          var iv = setInterval(function () {
            tries++;
            getJson(statusUrl).then(function (res) {
              var m = res.d;
              if (!res.ok) { clearInterval(iv); reject(m.error || 'superviseur indisponible'); return; }
              if (m.ready) { clearInterval(iv); barWrap.hidden = true; resolve(m); return; }
              if (m.error && !m.busy) { clearInterval(iv); reject(m.error); return; }
              barWrap.hidden = false; bar.style.width = (m.progress || 0) + '%';
              line.run('Installation de ' + label + '… ' + (m.progress || 0) + ' %');
              if (tries > 240) { clearInterval(iv); reject(label + ' ne démarre pas'); }
            }).catch(function () {});
          }, 1000);
        });
      }

      // Etape 1 : on choisit ; « Continuer » verifie ou installe ce qu'il faut, puis passe a la suite.
      var next1 = form.querySelector('[data-next="1"]');
      function onKind() {
        var k = kind();
        $('mongoUrlField').hidden = (k !== 'mongoExternal');
        $('testLine').hidden = (k !== 'mongoExternal');
        $('testMsg').textContent = '';
      }
      form.querySelectorAll('input[name=kind]').forEach(function (r) { r.addEventListener('change', onKind); });
      next1.addEventListener('click', function () {
        var k = kind();
        if (k === 'sqlite') { step('db', '').ok('Base : SQLite embarqué'); show(2); return; }
        next1.disabled = true;
        if (k === 'mongoExternal') {
          var lx = step('db', 'Test de la connexion à MongoDB externe…');
          post('/api/setup/test-db', dbPayload()).then(function (res) {
            if (res.d.ok) { lx.ok('Base : MongoDB externe, connexion vérifiée'); next1.disabled = false; show(2); }
            else { lx.ko('MongoDB externe : ' + (res.d.error || 'connexion impossible')); next1.disabled = false; }
          }).catch(function () { lx.ko('MongoDB externe : erreur réseau'); next1.disabled = false; });
          return;
        }
        // MongoDB fourni : deja installe -> on passe ; sinon installation avec progression.
        var lm = step('db', 'Vérification de MongoDB…');
        var statusUrl = '/api/setup/module?kind=' + encodeURIComponent(KIND[k]);
        getJson(statusUrl).then(function (res) {
          if (!res.ok) throw res.d.error || 'superviseur indisponible';
          if (res.d.ready) return res.d;
          return post('/api/setup/module', { kind: KIND[k] }).then(function (r2) {
            if (!r2.ok) throw r2.d.error || 'installation impossible';
            return waitModule(statusUrl, lm, $('moduleBarWrap'), $('moduleBar'), 'MongoDB');
          });
        }).then(function () { lm.ok('Base : MongoDB installé et démarré'); next1.disabled = false; show(2); })
          .catch(function (e) { lm.ko('MongoDB : ' + String(e)); next1.disabled = false; });
      });
      $('testBtn').addEventListener('click', function () {
        var msg = $('testMsg'); msg.className = 'testmsg'; msg.textContent = 'Test…';
        post('/api/setup/test-db', dbPayload()).then(function (res) {
          msg.className = 'testmsg ' + (res.d.ok ? 'ok' : 'err'); msg.textContent = res.d.ok ? '✓ connexion OK' : ('✗ ' + (res.d.error || 'échec'));
        }).catch(function () { msg.className = 'testmsg err'; msg.textContent = '✗ erreur réseau'; });
      });
      form.querySelector('[data-prev="2"]').addEventListener('click', function () { show(1); });

      // Etape 2 : noms pre-remplis ; « Terminer » prepare le broker (certificat au nom choisi, installation
      // ou redemarrage), verifie les deux noms jusqu'a cette instance, puis enregistre.
      var LABEL = { appFormat: 'Portail : format', appDns: 'Portail : DNS', appReach: 'Portail : joignable', brokerFormat: 'Broker : format', brokerCert: 'Broker : certificat', brokerDns: 'Broker : DNS', brokerPort: 'Broker : joignable' };
      var err = $('formErr'), fb = $('finishBtn');
      var asLines = function (list) { return list.map(function (c) { return { ok: c.ok, text: (LABEL[c.check] || c.check) + ' : ' + c.detail }; }); };
      getJson('/api/setup/defaults').then(function (res) {
        if (res.d.appHost && !$('appHost').value) $('appHost').value = res.d.appHost;
        if (res.d.brokerHost && !$('brokerHost').value) $('brokerHost').value = res.d.brokerHost;
      }).catch(function () {});

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        err.hidden = true; fb.disabled = true;
        var hosts = { appHost: $('appHost').value.trim(), brokerHost: $('brokerHost').value.trim() };
        var lb = step('broker', 'Certificat du broker pour ' + hosts.brokerHost + '…');
        var lc, ls;
        var fail = function (line, msg) { if (line) line.ko(msg); err.hidden = false; err.textContent = msg; fb.disabled = false; };
        post('/api/setup/broker', { brokerHost: hosts.brokerHost }).then(function (res) {
          if (!res.ok) throw { line: lb, msg: 'Broker : ' + (res.d.error || 'préparation impossible') };
          lb.ok('Certificat du broker émis pour ' + hosts.brokerHost);
          lb = step('brokerRun', 'Installation du broker…');
          if (res.d.ready) return res.d;
          return waitModule('/api/setup/broker', lb, $('brokerBarWrap'), $('brokerBar'), 'broker').catch(function (m) { throw { line: lb, msg: 'Broker : ' + m }; });
        }).then(function () {
          lb.ok('Broker installé et démarré');
          lc = step('checks', 'Vérification des noms d\'hôte…');
          return new Promise(function (r) { setTimeout(r, 2000); }).then(function () { return post('/api/setup/check-hosts', hosts); });
        }).then(function (res) {
          if (res.d.checks) lc.sub(asLines(res.d.checks));
          if (!res.d.ok) throw { line: lc, msg: 'Un nom ne mène pas à cette instance : voir le détail.' };
          lc.ok('Noms vérifiés : ' + hosts.appHost + ' et ' + hosts.brokerHost + ' mènent à cette instance');
          ls = step('save', 'Enregistrement de la configuration…');
          var db = dbPayload();
          return post('/api/setup/save', { kind: db.kind, mongoUrl: db.mongoUrl, appHost: hosts.appHost, brokerHost: hosts.brokerHost, adminEmail: $('adminEmail').value.trim(), adminName: $('adminName').value.trim(), adminPassword: $('adminPassword').value });
        }).then(function (res) {
          if (!res.ok) { if (res.d.checks && lc) lc.sub(asLines(res.d.checks)); throw { line: ls, msg: 'Enregistrement : ' + (res.d.error || 'échec') }; }
          ls.ok('Configuration enregistrée');
          done = true; clearInterval(tick); $('windowBar').hidden = true; show(3);
          var lr = step('restart', 'Redémarrage du portail…');
          var tries = 0;
          var go = function () { location.href = '/connexion?local=1'; };
          var iv = setInterval(function () {
            tries++;
            getJson('/api/setup/status').then(function (r) {
              if (r.d.configured) { clearInterval(iv); lr.ok('Portail redémarré : ouverture de la connexion…'); setTimeout(go, 3000); }
            }).catch(function () {});
            if (tries > 60) { clearInterval(iv); lr.ko('Le portail tarde à redémarrer : rechargez la page dans un instant.'); }
          }, 1500);
        }).catch(function (x) { fail(x && x.line, x && x.msg ? x.msg : String(x)); });
      });

      show(1);
    })();
  </script>
</BareLayout>
