---
import CloudLayout from '../layouts/CloudLayout.astro';
import UtilisateursView from '../components/views/UtilisateursView.astro';
import { requireUserAdmin } from '../server/auth.ts';
import { LANG, ROUTES, t } from '../lib/i18n.ts';
const lang = LANG.fr;
const acc = await requireUserAdmin(Astro.request);
if (!acc) return Astro.redirect(ROUTES.appareils[lang]);
---
<CloudLayout title={`${t(lang).usersTitle} · ISNO Cloud`} lang={lang} altUrl={ROUTES.utilisateurs[LANG.en]}>
  <UtilisateursView lang={lang} accountId={acc} />
</CloudLayout>
