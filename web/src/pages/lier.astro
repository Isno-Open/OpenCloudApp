---
import CloudLayout from '../layouts/CloudLayout.astro';
import LierView from '../components/views/LierView.astro';
import { resolveAccountId } from '../server/auth.ts';
import { getDeviceAuthByUserCode } from '@core/store.js';
import { DEVICE_AUTH_STATE } from '@core/types.js';
import { normalizeUserCode, displayUserCode } from '@core/device-code.js';
import { LANG, ROUTES, t } from '../lib/i18n.ts';
import { LINK_VIEW, LINK_COOKIE, type LinkView } from '../lib/link.ts';
const lang = LANG.fr;
const raw = Astro.url.searchParams.get('code') ?? Astro.cookies.get(LINK_COOKIE)?.value ?? '';
const acc = await resolveAccountId(Astro.request);
if (!acc) {
  // detour par la connexion : on garde le code scanne pour y revenir ensuite
  const n = normalizeUserCode(raw);
  if (n) Astro.cookies.set(LINK_COOKIE, n, { path: '/', httpOnly: true, sameSite: 'lax', maxAge: 600, secure: Astro.url.protocol === 'https:' });
  return Astro.redirect(ROUTES.connexion[lang]);
}
Astro.cookies.delete(LINK_COOKIE, { path: '/' });
let view: LinkView = LINK_VIEW.enter;
let code = '';
let deviceId = '';
if (raw) {
  const n = normalizeUserCode(raw);
  const rec = n ? await getDeviceAuthByUserCode(n) : null;
  if (n && rec && rec.state === DEVICE_AUTH_STATE.pending && rec.expiresAt > Date.now()) {
    view = LINK_VIEW.confirm; code = displayUserCode(n); deviceId = rec.deviceId;
  } else { view = LINK_VIEW.invalid; code = raw.slice(0, 12); }
}
---
<CloudLayout title={`${t(lang).linkTitle}`} lang={lang} altUrl={ROUTES.lier[LANG.en]}>
  <LierView lang={lang} view={view} code={code} deviceId={deviceId} />
</CloudLayout>
