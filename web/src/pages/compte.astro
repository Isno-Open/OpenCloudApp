---
import CloudLayout from '../layouts/CloudLayout.astro';
import CompteView from '../components/views/CompteView.astro';
import { resolveAccountId } from '../server/auth.ts';
import { LANG, ROUTES, t } from '../lib/i18n.ts';
const lang = LANG.fr;
const acc = await resolveAccountId(Astro.request);
if (!acc) return Astro.redirect(ROUTES.connexion[lang]);
---
<CloudLayout title={`${t(lang).accountTitle}`} lang={lang} altUrl={ROUTES.compte[LANG.en]}>
  <CompteView lang={lang} accountId={acc} />
</CloudLayout>
