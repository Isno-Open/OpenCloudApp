---
import BareLayout from '../../layouts/BareLayout.astro';
import PasswordView from '../../components/views/PasswordView.astro';
import { PASSWORD_MODE } from '../../lib/password-view.ts';
import { mailEnabled } from '@core/mail.js';
import { boot } from '../../server/boot.ts';
import { LANG, ROUTES, t } from '../../lib/i18n.ts';
const lang = LANG.en;
await boot();
if (!mailEnabled()) return Astro.redirect(`${ROUTES.connexion[lang]}?local=1`);
---
<BareLayout title={t(lang).forgotTitle} lang={lang}><PasswordView lang={lang} mode={PASSWORD_MODE.forgot} /></BareLayout>
