---
import BareLayout from '../../layouts/BareLayout.astro';
import PasswordView from '../../components/views/PasswordView.astro';
import { accountFromLink } from '../../pages/api/password/set.ts';
import { localAccountsSettings } from '@core/plugins/local-accounts-settings.js';
import { LANG, t } from '../../lib/i18n.ts';
const lang = LANG.en;
const token = Astro.url.searchParams.get('t') ?? '';
const valid = !!token && !!(await accountFromLink(token));
---
<BareLayout title={t(lang).setPasswordTitle} lang={lang}><PasswordView lang={lang} mode="set" token={token} valid={valid} minLength={localAccountsSettings().passwordMinLength} /></BareLayout>
