---
// Gabarit de l'app cloud : barre du site isno.fr + thème (sombre par défaut, clair en opt-in mémorisé)
// + bilingue (FR/EN) comme le site. On consomme l'identité (tokens), pas le BaseLayout marketing.
import '../styles/tokens.css';
import '../styles/cloud.css';
import { otherLang, navItems, t, type Lang } from '../lib/i18n.ts';

interface Props { title?: string; lang: Lang; altUrl: string; }
const { title = 'ISNO Cloud', lang, altUrl } = Astro.props;
const s = t(lang);
const other = otherLang(lang);
const path = Astro.url.pathname;
const nav = navItems(lang);
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <link rel="alternate" hreflang={lang} href={path} />
  <link rel="alternate" hreflang={other} href={altUrl} />
  <script is:inline>
    try { if (localStorage.getItem('theme') === 'light') document.documentElement.setAttribute('data-theme', 'light'); } catch (e) {}
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" />
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a class="brand" href={nav[0]!.href} aria-label={s.brandAria}>
        <svg class="rf" viewBox="0 0 28 28" aria-hidden="true">
          <circle cx="6" cy="14" r="2.6" fill="currentColor"></circle>
          <g fill="none" stroke="currentColor" stroke-linecap="round">
            <path d="M11 8 A8 8 0 0 1 11 20" stroke-width="2.2"></path>
            <path d="M15.5 5 A12.5 12.5 0 0 1 15.5 23" stroke-width="2.2" opacity=".65"></path>
            <path d="M20 2.5 A16.5 16.5 0 0 1 20 25.5" stroke-width="2" opacity=".38"></path>
          </g>
        </svg>
        <span>isno<span class="tld">.fr</span></span>
      </a>
      <button class="burger" id="menuToggle" type="button" aria-label={s.menu} aria-expanded="false" aria-controls="navLinks">
        <svg class="bars" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"></path></svg>
        <svg class="x" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 5 19 19M19 5 5 19"></path></svg>
      </button>
      <nav class="topbar-links" id="navLinks">
        {nav.map((n) => (
          <a class:list={['nav', { active: n.active(path) }]} href={n.href}>{n.label}</a>
        ))}
        <a class="nav" href="https://www.isno.fr" target="_blank" rel="noopener">isno.fr</a>
        <div class="topbar-controls">
          <a class="lang-switch" href={altUrl} hreflang={other} aria-label={s.langSwitch}>{s.langName}</a>
          <button class="theme-toggle" id="themeToggle" type="button" aria-label={s.themeToggle}>
            <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
            <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
          </button>
        </div>
      </nav>
    </div>
  </header>

  <main class="wrap">
    <slot />
    <p class="foot">{s.footNote}</p>
  </main>

  <script is:inline>
    (function () {
      var root = document.documentElement;
      var tb = document.getElementById('themeToggle');
      if (tb) tb.addEventListener('click', function () {
        var light = root.getAttribute('data-theme') === 'light';
        if (light) { root.removeAttribute('data-theme'); try { localStorage.setItem('theme', 'dark'); } catch (e) {} }
        else { root.setAttribute('data-theme', 'light'); try { localStorage.setItem('theme', 'light'); } catch (e) {} }
      });
      var mt = document.getElementById('menuToggle'), nav = document.getElementById('navLinks');
      if (mt && nav) {
        function close() { nav.classList.remove('open'); mt.setAttribute('aria-expanded', 'false'); }
        mt.addEventListener('click', function (e) { e.stopPropagation(); var o = nav.classList.toggle('open'); mt.setAttribute('aria-expanded', o ? 'true' : 'false'); });
        document.addEventListener('click', function (e) { if (nav.classList.contains('open') && !nav.contains(e.target) && e.target !== mt) close(); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
      }
    })();
  </script>
</body>
</html>
