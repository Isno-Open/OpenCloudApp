---
// Carte d'un appareil, au visuel EXACT du firmware OpenProfalux : icone de type, dpad glyphes,
// volet dessine (slat) pour les positionnels, roue crantee pour les details + renommage.
// Libelles de commande localises PAR TYPE (i18n.actionLabels) : le device declare le type, l'app traduit.
import { DEVICE_TYPE, type Appareil } from '../lib/types.ts';
import { actionLabels, t, type Lang } from '../lib/i18n.ts';
interface Props { appareil: Appareil; boitierName: string; lang: Lang; }
const { appareil: a, boitierName, lang } = Astro.props;
const s = t(lang);
const act = actionLabels(a.type, lang);
const isPortail = a.type === DEVICE_TYPE.portail;
const showPos = a.positional && a.position !== null;
---
<div class:list={['volet', { offline: !a.online }]} data-box={a.boitierId}>
  <div class="top">
    <span class="ico">
      {isPortail ? (
        <svg viewBox="0 0 24 24" width="1.05em" height="1.05em" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px"><path d="M4 8h12v12H4M4 11h12M4 14h12M4 17h12M1 20h22M18 14h4M20 12l2 2-2 2"></path></svg>
      ) : '🪟'}
    </span>
    <span class="vname">{a.name}</span>
    {showPos && <span class="pct">{a.position} %</span>}
  </div>

  <div class="dpad" data-device={a.boitierId} data-slug={a.slug}>
    <button type="button" data-action="UP" title={act.up} aria-label={act.up} disabled={!a.online}>▲</button>
    <button type="button" data-action="STOP" title={act.stop} aria-label={act.stop} disabled={!a.online}>■</button>
    <button type="button" data-action="DOWN" title={act.down} aria-label={act.down} disabled={!a.online}>▼</button>
  </div>

  {a.positional && (
    <div class="slat" style={`--p:${a.position ?? 0}${a.online ? '' : ';opacity:.5'}`} title={showPos ? `${a.position} %` : undefined}></div>
  )}

  <div class="foot">
    <span class="box-tag"><span class:list={['dot', { off: !a.online }]}></span>{boitierName}{!a.online && s.offlineSuffix}</span>
    <button class="gear" type="button" data-det title={s.details} aria-label={s.details}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
    </button>
  </div>

  <div class="hw-det" hidden>
    <div class="mini-field"><input type="text" value={a.name} aria-label={s.nameLabel} /><button class="btn sm primary" type="button">{s.rename}</button></div>
    <div class="kv"><span class="k">{s.typeWord}</span><span class="v">{a.type} · {a.positional ? s.positional : s.impulsional}</span></div>
    {showPos && <div class="kv"><span class="k">{s.posWord}</span><span class="v">{a.position} %</span></div>}
    {a.rssiDbm != null && <div class="kv"><span class="k">{s.wifiSignal}</span><span class="v">{s.radioState(a.rssiDbm)}</span></div>}
    {!a.online && <div class="kv"><span class="k">{s.state}</span><span class="v">{s.offline}</span></div>}
  </div>
</div>
