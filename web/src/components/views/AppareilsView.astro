---
// Accueil : « Mes appareils ». Un appareil = un boitier OpenProfalux. On liste les appareils, chacun en
// section avec ses volets/portails (cartes au visuel firmware) dessous. La roue crantee ouvre la config.
import DeviceCard from '../DeviceCard.svelte';
import UnknownDeviceCard from '../UnknownDeviceCard.astro';
import { isKnownAppareil } from '../../lib/types.ts';
import LinkCodeForm from '../LinkCodeForm.astro';
import { getAccountInfo, listBoitiers, listAppareils } from '../../lib/cloud-data.ts';
import { t, ROUTES, appareilHref, type Lang } from '../../lib/i18n.ts';
import type { Appareil } from '../../lib/types.ts';
interface Props { lang: Lang; accountId: string; }
const { lang, accountId } = Astro.props;
const s = t(lang);
const [account, boitiers, appareils] = await Promise.all([
  getAccountInfo(accountId), listBoitiers(accountId), listAppareils(accountId),
]);
const coversOf = (boitierId: string): Appareil[] => appareils.filter((a) => a.boitierId === boitierId);
---
<div class="page-head"><h1>{s.appareilsTitle}</h1></div>
<p class="lead">{account.email} · {s.leadAppareils(boitiers.length)}</p>

{boitiers.length ? boitiers.map((b) => {
  const covers = coversOf(b.id);
  return (
    <section class="appareil-group">
      <div class="grp-head" style={b.online ? undefined : 'opacity:.75'}>
        <span class:list={['dot', { off: !b.online }]}></span>
        <span class="grp-name">{b.name}</span>
        {b.updateAvailable && <span class="pill upd">{s.updAvail}</span>}
        <span class="grp-sub">{covers.length} {s.devicesWord}</span>
        <span style="flex:1"></span>
        <a class="gear" href={appareilHref(b.id, lang)} title={s.configure} aria-label={`${s.configure} ${b.name}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
        </a>
      </div>
      {covers.length ? (
        <div class="hw-grid">
          {covers.map((a) => isKnownAppareil(a)
            ? <DeviceCard client:load appareil={a} boitierName={b.name} lang={lang} grouped={true} />
            : <UnknownDeviceCard appareil={a} boitierName={b.name} lang={lang} grouped={true} />)}
        </div>
      ) : (
        <p class="empty">{s.noCovers}</p>
      )}
    </section>
  );
}) : (
  <section class="welcome">
    <h2>{s.welcomeTitle}</h2>
    <p class="note">{s.welcomeLead}</p>
    <ol class="welcome-steps">
      <li>{s.welcomeStep1}</li>
      <li>{s.welcomeStep2}</li>
      <li>{s.welcomeStep3}</li>
    </ol>
    <LinkCodeForm lang={lang} />
    <p class="legacy">{s.legacyHint} <a href={ROUTES.ajouter[lang]}>{s.legacyLink}</a></p>
  </section>
)}
