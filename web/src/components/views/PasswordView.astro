---
// Mot de passe oublie (demande d'un lien) et choix du mot de passe (depuis un lien signe), au meme
// visuel que la connexion.
import { t, ROUTES, type Lang } from '../../lib/i18n.ts';
import { portalName, portalNameIsCustom } from '../../lib/portal.ts';
interface Props { lang: Lang; mode: 'forgot' | 'set'; token?: string; valid?: boolean; minLength?: number; }
const { lang, mode, token = '', valid = false, minLength = 8 } = Astro.props;
const s = t(lang);
---
<div class="login">
  {portalNameIsCustom() ? <span class="login-mark">{portalName()}</span> : <span class="login-mark">isno<span class="tld">.fr</span></span>}
  {mode === 'forgot' ? (
    <form class="login-box" id="pwForm" data-mode="forgot">
      <h1>{s.forgotTitle}</h1>
      <p class="note">{s.forgotIntro}</p>
      <label for="em">{s.signInUser}</label>
      <input id="em" type="email" autocomplete="username" autofocus required />
      <p class="note" id="pwDone" hidden>{s.forgotSent}</p>
      <button type="submit">{s.forgotBtn}</button>
      <a class="login-link" href={`${ROUTES.connexion[lang]}?local=1`}>{s.backToLogin}</a>
    </form>
  ) : valid ? (
    <form class="login-box" id="pwForm" data-mode="set">
      <h1>{s.setPasswordTitle}</h1>
      <label for="pw">{s.newPassword}</label>
      <input id="pw" type="password" autocomplete="new-password" minlength={minLength} autofocus required />
      <label for="pw2">{s.confirmPassword}</label>
      <input id="pw2" type="password" autocomplete="new-password" minlength={minLength} required />
      <p class="err" id="pwErr" hidden></p>
      <button type="submit">{s.setPasswordBtn}</button>
    </form>
  ) : (
    <div class="login-box">
      <h1>{s.setPasswordTitle}</h1>
      <p class="err">{s.linkExpired}</p>
      <a class="login-link" href={ROUTES.oubli[lang]}>{s.askNewLink}</a>
    </div>
  )}
</div>
<script is:inline define:vars={{ lang, token, loginUrl: `${ROUTES.connexion[lang]}?local=1&ok=password`, mismatch: s.passwordMismatch, netErr: s.netErr }}>
  (function () {
    var f = document.getElementById('pwForm'); if (!f) return;
    var post = function (url, body) { return fetch(url, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) }).then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); }); };
    f.addEventListener('submit', function (e) {
      e.preventDefault();
      var btn = f.querySelector('button'); btn.disabled = true;
      if (f.getAttribute('data-mode') === 'forgot') {
        post('/api/password/forgot', { email: document.getElementById('em').value.trim(), lang: lang })
          .then(function () { document.getElementById('pwDone').hidden = false; })
          .catch(function () { btn.disabled = false; });
        return;
      }
      var err = document.getElementById('pwErr'); err.hidden = true;
      var a = document.getElementById('pw').value, b = document.getElementById('pw2').value;
      if (a !== b) { err.hidden = false; err.textContent = mismatch; btn.disabled = false; return; }
      post('/api/password/set', { token: token, password: a }).then(function (res) {
        if (res.ok) { location.href = loginUrl; return; }
        err.hidden = false; err.textContent = res.d.error || 'échec'; btn.disabled = false;
      }).catch(function () { err.hidden = false; err.textContent = netErr; btn.disabled = false; });
    });
  })();
</script>
