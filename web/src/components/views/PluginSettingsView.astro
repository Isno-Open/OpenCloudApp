---
// Ecran de reglages d'un plugin. Le cadre (retour, titre, panneau, bouton unique) est le meme pour tous
// les plugins : seul le contenu varie, et il vient de ce que le plugin DECLARE (champs, bornes, libelles).
import type { PluginInfo, SettingField, SettingValue } from '@core/plugin-types.js';
import PluginSettingsForm from '../islands/PluginSettingsForm.svelte';
import { t, ROUTES, type Lang } from '../../lib/i18n.ts';
interface Props { lang: Lang; plugin: PluginInfo; fields: readonly SettingField[]; values: Record<string, SettingValue>; }
const { lang, plugin, fields, values } = Astro.props;
const s = t(lang);
---
<a class="backlink" href={ROUTES.plugins[lang]}>← {s.pluginsTitle}</a>
<div class="page-head"><h1>{plugin.title}</h1></div>
<p class="lead">{s.pluginSettingsLead} <span class="ro">{plugin.builtin ? s.pluginBuiltin : s.pluginExternal}</span></p>

<PluginSettingsForm client:load lang={lang} pluginId={plugin.id} fields={fields} values={values} />
