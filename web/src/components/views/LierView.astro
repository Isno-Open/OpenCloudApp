---
// Liaison d'un appareil (device grant, cote utilisateur). Trois etats : saisir un code, confirmer
// l'appareil trouve, ou code invalide/expire. La confirmation appelle /api/device/approve ; le boitier,
// qui interroge de son cote, recupere alors son certificat.
import LinkCodeForm from '../LinkCodeForm.astro';
import { t, type Lang } from '../../lib/i18n.ts';
import { LINK_VIEW, type LinkView } from '../../lib/link.ts';
import LinkConfirm from '../islands/LinkConfirm.svelte';
interface Props { lang: Lang; view: LinkView; code?: string; deviceId?: string; }
const { lang, view, code = '', deviceId = '' } = Astro.props;
const s = t(lang);
---
<div class="page-head"><h1>{s.linkTitle}</h1></div>

{view === LINK_VIEW.confirm ? (
  <LinkConfirm client:load lang={lang} code={code} deviceId={deviceId} />
) : (
  <>
    <p class="lead">{s.linkLead}</p>
    {view === LINK_VIEW.invalid && <p class="formerr" style="margin:0 0 .8rem">{s.linkInvalid}</p>}
    <div class="panel"><LinkCodeForm lang={lang} value={view === LINK_VIEW.invalid ? code : ''} /></div>
  </>
)}
