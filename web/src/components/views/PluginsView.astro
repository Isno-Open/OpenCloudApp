---
// Ecran operateur : plugins. Installes (reglages par l'ecrou, desactivation), puis ceux qu'on peut
// ajouter : plugins integres desactives, et catalogue ISNO (le superviseur les installe). Activer ou
// retirer un plugin redemarre le portail, qui le charge (ou l'oublie) au demarrage.
import { installedPlugins, BUILTIN_PLUGINS, enabledPlugins } from '@core/plugins.js';
import { listCatalogPlugins } from '../../server/supervisor.ts';
import { t, pluginHref, type Lang } from '../../lib/i18n.ts';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const s = t(lang);
const installed = installedPlugins();
const enabled = enabledPlugins();
const signInCount = installed.filter((p) => p.signIn).length;
const builtinOff = Object.values(BUILTIN_PLUGINS).filter((p) => !enabled.includes(p.id));
const catalog = await listCatalogPlugins();
const available = catalog.ok ? catalog.plugins.filter((p) => !enabled.includes(p.id)) : [];
---
<div class="page-head"><h1>{s.pluginsTitle}</h1></div>
<p class="lead">{s.pluginsLead}</p>

<div class="panel">
  <h3>{s.pluginsInstalled}</h3>
  {installed.map((p) => (
    <div class="plugin-row">
      <div class="plugin-main">
        <span class="k">{p.title} <span class="ro">{p.builtin ? s.pluginBuiltin : s.pluginExternal}</span></span>
        {p.description && <span class="hint">{p.description[lang]}</span>}
      </div>
      <div class="plugin-act">
        {p.configurable && (
          <a class="gear" href={pluginHref(p.id, lang)} title={s.pluginSettings} aria-label={`${s.pluginSettings} : ${p.title}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg>
          </a>
        )}
        {enabled.includes(p.id) && (p.signIn && signInCount <= 1
          ? <span class="hint" title={s.pluginLastSignIn}>{s.pluginRequired}</span>
          : <button class="btn ghost sm" type="button" data-disable={p.id}>{p.builtin ? s.pluginDisable : s.pluginRemove}</button>)}
      </div>
    </div>
  ))}
</div>

<div class="panel" style="margin-top:.9rem">
  <h3>{s.pluginsAdd}</h3>
  {!catalog.ok && <p class="formerr" style="margin:0 0 .5rem">{s.pluginsCatalogDown} ({catalog.error})</p>}
  {builtinOff.map((p) => (
    <div class="plugin-row">
      <div class="plugin-main"><span class="k">{p.title} <span class="ro">{s.pluginBuiltin}</span></span>{p.description && <span class="hint">{p.description[lang]}</span>}</div>
      <div class="plugin-act"><button class="btn primary sm" type="button" data-enable={p.id}>{s.pluginEnable}</button></div>
    </div>
  ))}
  {available.map((p) => (
    <div class="plugin-row">
      <div class="plugin-main"><span class="k">{p.title} <span class="ro">{s.pluginCatalog}</span></span><span class="hint">{p.description[lang]}</span>
        <div class="bar" hidden data-bar={p.id}><span></span></div></div>
      <div class="plugin-act"><button class="btn primary sm" type="button" data-install={p.id}>{s.pluginInstall}</button></div>
    </div>
  ))}
  {catalog.ok && builtinOff.length === 0 && available.length === 0 && <p class="hint" style="margin:0">{s.pluginsNoneAvailable}</p>}
  <p class="formerr" id="pluginsErr" hidden></p>
  <p class="savemsg" id="pluginsMsg"></p>
</div>

<script is:inline define:vars={{ restartingMsg: s.pluginRestarting, installingMsg: s.pluginInstalling, errMsg: s.saveError }}>
  (function () {
    var err = document.getElementById('pluginsErr'), msg = document.getElementById('pluginsMsg');
    var fail = function (m) { err.hidden = false; err.textContent = m; document.querySelectorAll('button').forEach(function (b) { b.disabled = false; }); };
    var post = function (url, body) { return fetch(url, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) }).then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); }); };
    // le portail redemarre : on attend qu'il soit tombe puis revenu, et on recharge
    function waitRestart() {
      msg.textContent = restartingMsg;
      var seenDown = false, tries = 0;
      (function poll() {
        fetch('/api/setup/status', { cache: 'no-store' }).then(function (r) {
          if (r.ok && (seenDown || tries > 4)) { location.reload(); return; }
          tries++; setTimeout(poll, 800);
        }).catch(function () { seenDown = true; tries++; setTimeout(poll, 800); });
      })();
    }
    function act(url, id) {
      document.querySelectorAll('button').forEach(function (b) { b.disabled = true; });
      post(url, { id: id }).then(function (res) { if (res.ok) waitRestart(); else fail(res.d.error || errMsg); }).catch(function () { fail(errMsg); });
    }
    document.querySelectorAll('[data-disable]').forEach(function (b) { b.addEventListener('click', function () { act('/api/plugins/disable', b.getAttribute('data-disable')); }); });
    document.querySelectorAll('[data-enable]').forEach(function (b) { b.addEventListener('click', function () { act('/api/plugins/enable', b.getAttribute('data-enable')); }); });
    document.querySelectorAll('[data-install]').forEach(function (b) {
      b.addEventListener('click', function () {
        var id = b.getAttribute('data-install'), bar = document.querySelector('[data-bar="' + id + '"]');
        document.querySelectorAll('button').forEach(function (x) { x.disabled = true; });
        msg.textContent = installingMsg; bar.hidden = false;
        post('/api/plugins/install', { id: id }).then(function (res) {
          if (!res.ok) { fail(res.d.error || errMsg); return; }
          (function poll() {
            fetch('/api/plugins/status?id=' + encodeURIComponent(id), { cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (st) {
              bar.firstElementChild.style.width = (st.progress || 0) + '%';
              if (st.error) { fail(st.error); return; }
              if (st.busy) { setTimeout(poll, 700); return; }
              act('/api/plugins/enable', id);
            }).catch(function () { fail(errMsg); });
          })();
        }).catch(function () { fail(errMsg); });
      });
    });
  })();
</script>
