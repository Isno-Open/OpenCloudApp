---
// Ecran operateur : plugins. Le serveur prepare les donnees (installes, catalogue, sources) ; l'ecran
// lui-meme est le composant interactif PluginsPanel (Svelte, rendu d'abord par le serveur).
import { installedPlugins, BUILTIN_PLUGINS, enabledPlugins } from '@core/plugins.js';
import { loadConfig } from '@core/config.js';
import { listCatalogPlugins } from '../../server/supervisor.ts';
import { t, type Lang } from '../../lib/i18n.ts';
import type { InstalledRow, CatalogEntry, SourceRow } from '../../lib/plugins-view.ts';
import PluginsPanel from '../islands/PluginsPanel.svelte';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const s = t(lang);
const enabled = enabledPlugins();
const sourceUrls = loadConfig()?.pluginSources ?? [];
const catalog = await listCatalogPlugins(sourceUrls);
const installed: InstalledRow[] = installedPlugins().map((p) => ({ ...p, enabled: enabled.includes(p.id) }));
// Catalogue affiche : les plugins integres (livres avec le portail) puis ceux des sources. Installes ou non :
// il n'est donc jamais vide, et dit ce qui est deja en place.
const entries: CatalogEntry[] = [
  ...Object.values(BUILTIN_PLUGINS).map((p) => ({ id: p.id, title: p.title, description: p.description, origin: s.pluginBuiltin, builtin: true, enabled: enabled.includes(p.id) })),
  ...(catalog.ok ? catalog.plugins.map((p) => ({
    id: p.id, title: p.title, description: p.description, origin: p.official ? s.pluginCatalog : p.local ? s.pluginLocal : new URL(p.source).host,
    builtin: false, enabled: enabled.includes(p.id), version: p.version, installedVersion: p.installedVersion, updateAvailable: p.updateAvailable,
  })) : []),
];
const sourceErrors = catalog.ok ? catalog.errors : [];
const sources: SourceRow[] = sourceUrls.map((url) => {
  const err = sourceErrors.find((e) => e.source === url);
  return err ? { url, error: err.error } : { url };
});
---
<div class="page-head"><h1>{s.pluginsTitle}</h1></div>
<p class="lead">{s.pluginsLead}</p>

<PluginsPanel client:load lang={lang} installed={installed} entries={entries} sources={sources} catalogError={catalog.ok ? null : catalog.error} />
