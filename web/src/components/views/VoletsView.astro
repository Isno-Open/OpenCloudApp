---
import VoletCard from '../VoletCard.astro';
import { getAccountInfo, listBoitiers, listAppareils } from '../../lib/cloud-data.ts';
import { t, type Lang } from '../../lib/i18n.ts';
interface Props { lang: Lang; accountId: string; }
const { lang, accountId } = Astro.props;
const s = t(lang);
const [account, boitiers, appareils] = await Promise.all([
  getAccountInfo(accountId), listBoitiers(accountId), listAppareils(accountId),
]);
const nameOf = new Map(boitiers.map((b) => [b.id, b.name]));
---
<div class="page-head"><h1>{s.voletsTitle}</h1></div>
<p class="lead">{account.email} · {s.leadVolets(appareils.length, boitiers.length)}</p>

{boitiers.length > 1 && (
  <div class="filters" id="filters">
    <button class="chip active" type="button" data-box="all">{s.filterAll}</button>
    {boitiers.map((b) => (
      <button class="chip" type="button" data-box={b.id}>
        <span class:list={['dot', { off: !b.online }]}></span>{b.name}
      </button>
    ))}
  </div>
)}

{appareils.length ? (
  <div class="hw-grid" id="voletsGrid">
    {appareils.map((a) => <VoletCard appareil={a} boitierName={nameOf.get(a.boitierId) ?? a.boitierId} lang={lang} />)}
  </div>
) : (
  <p class="empty">{s.voletsEmpty}</p>
)}

<script is:inline>
  (function () {
    var grid = document.getElementById('voletsGrid');
    document.querySelectorAll('#filters .chip').forEach(function (c) {
      c.addEventListener('click', function () {
        document.querySelectorAll('#filters .chip').forEach(function (x) { x.classList.remove('active'); });
        c.classList.add('active');
        var box = c.getAttribute('data-box');
        if (grid) grid.querySelectorAll('.volet').forEach(function (v) {
          v.hidden = (box !== 'all' && v.getAttribute('data-box') !== box);
        });
      });
    });
    document.querySelectorAll('.gear[data-det]').forEach(function (g) {
      g.addEventListener('click', function () {
        var d = g.closest('.volet').querySelector('.hw-det');
        if (d) d.hidden = !d.hidden;
      });
    });
    // commandes : chaque bouton du dpad envoie device_id + slug + action au relais.
    document.querySelectorAll('.dpad').forEach(function (pad) {
      var device = pad.getAttribute('data-device'), slug = pad.getAttribute('data-slug');
      pad.querySelectorAll('button[data-action]').forEach(function (b) {
        b.addEventListener('click', function () {
          if (b.disabled) return;
          b.classList.add('sending');
          fetch('/api/cmd', { method: 'POST', headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ device_id: device, slug: slug, action: b.getAttribute('data-action') }) })
            .catch(function () {})
            .finally(function () { setTimeout(function () { b.classList.remove('sending'); }, 400); });
        });
      });
    });
  })();
</script>
