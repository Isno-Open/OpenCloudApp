---
// Ecran operateur : gestion des comptes locaux. L'admin cree des utilisateurs (chacun pilote SES appareils)
// et peut en faire des operateurs. Reserve a l'admin (la page gate l'acces).
import { listAccounts, countDevices } from '@core/store.js';
import { t, type Lang } from '../../lib/i18n.ts';
interface Props { lang: Lang; accountId: string; }
const { lang, accountId } = Astro.props;
const s = t(lang);
const accounts = await listAccounts();
const counts = new Map<string, number>();
for (const a of accounts) counts.set(a.id, await countDevices(a.id));
---
<div class="page-head"><h1>{s.usersTitle}</h1></div>
<p class="lead">{s.usersLead}</p>

<form class="panel" id="userForm" style="margin-bottom:1rem">
  <h3>{s.userNewTitle}</h3>
  <div class="form-grid">
    <div class="field"><label for="u-login">{s.userLogin}</label><input id="u-login" name="login" type="text" autocomplete="off" spellcheck="false" required /></div>
    <div class="field"><label for="u-pass">{s.userPassword}</label><input id="u-pass" name="password" type="password" autocomplete="new-password" minlength="8" required /></div>
    <div class="field"><label for="u-cap">{s.userCap}</label><input id="u-cap" name="cap" type="number" min="1" value="5" required /></div>
  </div>
  <label class="check"><input type="checkbox" id="u-admin" name="admin" /> {s.userMakeAdmin}</label>
  <div class="row end" style="margin-top:.7rem"><button class="btn primary" type="submit">{s.createUserBtn}</button></div>
  <p class="formerr" id="userErr" hidden></p>
</form>

<div class="panel">
  <h3>{s.usersListTitle}</h3>
  <div class="utable">
    <div class="ut-head"><span>{s.colLogin}</span><span>{s.colRole}</span><span>{s.colCap}</span><span>{s.colDevices}</span><span></span></div>
    {accounts.map((a) => (
      <div class="ut-row">
        <span class="mono">{a.id}{a.id === accountId && <span class="youtag">{s.youTag}</span>}</span>
        <span><span class:list={['role', { op: a.admin }]}>{a.admin ? s.roleAdmin : s.roleUser}</span></span>
        <span>{a.deviceCap}</span>
        <span>{counts.get(a.id) ?? 0}</span>
        <span class="ut-act">
          {a.id !== accountId && a.id !== 'admin' && (
            <button class="btn danger sm" type="button" data-del={a.id}>{s.removeUser}</button>
          )}
        </span>
      </div>
    ))}
  </div>
</div>

<script is:inline define:vars={{ createErr: s.createUserError, removeErr: s.removeUserError, confirmTpl: s.confirmRemoveUser('__ID__') }}>
  (function () {
    var form = document.getElementById('userForm');
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var err = document.getElementById('userErr'); err.hidden = true;
      var payload = {
        login: document.getElementById('u-login').value.trim(),
        password: document.getElementById('u-pass').value,
        cap: parseInt(document.getElementById('u-cap').value, 10) || 5,
        admin: document.getElementById('u-admin').checked,
      };
      fetch('/api/user/new', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload) })
        .then(function (r) { if (r.ok) location.reload(); else { err.hidden = false; err.textContent = createErr; } })
        .catch(function () { err.hidden = false; err.textContent = createErr; });
    });
    document.querySelectorAll('[data-del]').forEach(function (b) {
      b.addEventListener('click', function () {
        var id = b.getAttribute('data-del');
        if (!confirm(confirmTpl.replace('__ID__', id))) return;
        fetch('/api/user/delete', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id: id }) })
          .then(function (r) { if (r.ok) location.reload(); else alert(removeErr); })
          .catch(function () { alert(removeErr); });
      });
    });
  })();
</script>
