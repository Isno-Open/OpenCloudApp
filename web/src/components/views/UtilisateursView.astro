---
// Ecran operateur : gestion des comptes locaux. L'admin cree des utilisateurs (chacun pilote SES appareils)
// et peut en faire des operateurs. Reserve a l'admin (la page gate l'acces).
import { listAccounts, countDevices } from '@core/store.js';
import { t, type Lang } from '../../lib/i18n.ts';
import UsersPanel from '../islands/UsersPanel.svelte';
import type { UserRow } from '../../lib/users-view.ts';
import { localAccountsSettings } from '@core/plugins/local-accounts-settings.js';
import { mailEnabled } from '@core/mail.js';
interface Props { lang: Lang; accountId: string; }
const { lang, accountId } = Astro.props;
const s = t(lang);
const accounts = await listAccounts();
const operators = accounts.filter((a) => a.admin).length;
const minPass = localAccountsSettings().passwordMinLength;
const canInvite = mailEnabled();   // messagerie configuree : le mot de passe devient facultatif (invitation)
const now = Date.now();
const counts = new Map<string, number>();
for (const a of accounts) counts.set(a.id, await countDevices(a.id));
const rows: UserRow[] = accounts.map((a) => ({
  id: a.id, name: a.name ?? a.id, admin: a.admin, totpEnabled: !!a.totpEnabled,
  locked: !!a.lockedUntil && a.lockedUntil > now, invited: !a.passHash,
  cap: a.deviceCap, devices: counts.get(a.id) ?? 0,
  isSelf: a.id === accountId, canChange: a.id !== accountId && !(a.admin && operators <= 1),
}));
---
<div class="page-head"><h1>{s.usersTitle}</h1></div>
<p class="lead">{s.usersLead}</p>

<UsersPanel client:load lang={lang} rows={rows} minPass={minPass} canInvite={canInvite} />
