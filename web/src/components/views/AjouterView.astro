---
import LinkCodeForm from '../LinkCodeForm.astro';
import PairCodeButton from '../islands/PairCodeButton.svelte';
import { t, type Lang } from '../../lib/i18n.ts';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const s = t(lang);
---
<div class="page-head"><h1>{s.addTitle}</h1></div>
<p class="lead">{s.addLead}</p>

<div class="card">
  <LinkCodeForm lang={lang} />
</div>

<div class="card">
  <PairCodeButton client:load lang={lang} />
</div>

<div class="card">
  <div class="sect-label">{s.howTitle}</div>
  <p class="note">{s.howText}</p>
</div>
