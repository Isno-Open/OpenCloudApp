---
// Carte d'un appareil dont le TYPE n'est pas gere par le portail : on le montre (le boitier l'a
// declare, l'utilisateur doit le voir) mais sans commandes, puisqu'on ne sait pas ce qu'elles feraient.
// Meme cadre que la carte de commande (classes communes) ; seul le contenu differe.
import type { Appareil } from '../lib/types.ts';
import { t, type Lang } from '../lib/i18n.ts';
interface Props { appareil: Appareil; boitierName: string; lang: Lang; grouped?: boolean; }
const { appareil: a, boitierName, lang, grouped = false } = Astro.props;
const s = t(lang);
---
<div class:list={['volet', 'unknown', { offline: !a.online }]} data-box={a.boitierId}>
  <div class="top">
    <span class="ico" aria-hidden="true">?</span>
    <span class="vname">{a.name}</span>
  </div>
  <p class="note unknown-note"><strong>{s.unknownDevice}</strong><br />{a.declaredType ? s.unknownDeclared(a.declaredType) : s.unknownNoType}</p>
  <div class="foot">
    {grouped
      ? <span class="box-tag">{!a.online && (<><span class="dot off"></span>{s.offlineShort}</>)}</span>
      : <span class="box-tag"><span class:list={['dot', { off: !a.online }]}></span>{boitierName}{!a.online && s.offlineSuffix}</span>}
  </div>
</div>
