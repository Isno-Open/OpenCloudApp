# Copier en .env et remplir. NE PAS commiter .env.

# Signe les sessions de connexion.
SESSION_SECRET=change-moi-secret-session-long
# Acces operateur par API (en-tete Authorization: Bearer).
ADMIN_TOKEN=change-moi-un-long-jeton

# --- Optionnel ---
# Duree d'ouverture de /setup apres le demarrage du serveur, en secondes.
# PORTAL_SETUP_WINDOW_S=300
# Port public du broker MQTT (redirection du compose ET adresse donnee aux boitiers).
# BROKER_PUBLIC_PORT=8883
# Cache du MongoDB installe par le superviseur, en Go.
# MONGO_CACHE_GB=0.25
# Plugin « Connexion par un site externe » : son secret partage est CREE par le plugin a sa premiere
# activation et montre dans son ecrou (a donner au site externe). Ne poser SSO_SECRET que pour imposer
# un secret deja en place ; il a alors priorite.
# SSO_SECRET=change-moi-un-long-secret-partage

# --- Deploiement automatise SANS l'ecran /setup ---
# La configuration est alors construite depuis ces variables.
# PORTAL_SEED=1
# PUBLIC_APP_URL=https://cloud.mondomaine.fr
# BROKER_URL_PUBLIC=mqtts://mqtt.mondomaine.fr:8883
# Absent : SQLite.
# MONGO_URL=mongodb://hote:27017
# ADMIN_PASS=change-moi-mot-de-passe-admin
